# Переменные окружения сервиса «Календарь звонков» (ADR-0013).
# Файл .env автоматически не подхватывается — задайте переменные в окружении.
# Значения ниже — дефолты; незаданную переменную можно опустить.
# Некорректное значение роняет старт с понятной ошибкой.

# Порт HTTP-сервера (целое 1–65535).
PORT=3000

# Хост HTTP-сервера (непустая строка).
HOST=0.0.0.0

# Путь к файлу SQLite; каталог создаётся при старте.
DATABASE_PATH=./data/calendar.sqlite

# IANA-зона сервиса: в ней трактуются рабочее окно и календарные сутки.
SERVICE_TIMEZONE=Europe/Moscow

# Рабочее окно: ежедневный интервал HH:MM (24 ч), начало раньше конца.
WORK_DAY_START=09:00
WORK_DAY_END=18:00

# Длина окна записи в календарных сутках (целое 1–365).
BOOKING_WINDOW_DAYS=14

# --- MCP-серверы (инструменты разработки, не влияют на рантайм сервиса) ---
# Ключ для MCP-сервера Render (opencode.json → mcp.servers.render).
# Нужен только для работы с Render-инфраструктурой через MCP; в Git не коммитится.
# Получить: Render Dashboard → Account Settings → API Keys.
RENDER_API_KEY=

{
  "name": "contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeSpec-контракты HTTP API сервиса «Календарь звонков» (ADR-0008)",
  "exports": {
    ".": {
      "types": "./generated/openapi.d.ts"
    }
  },
  "scripts": {
    "generate": "tsp compile . && openapi-typescript tsp-output/@typespec/openapi3/openapi.yaml -o generated/openapi.d.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf tsp-output generated"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "openapi-typescript": "^7.13.0",
    "vitest": "^5.0.3"
  }
}
